# Credentials for the historical-data collector. Copy to `.env` (git-ignored)
# and fill in. Values already exported by your shell take precedence.
#
#   cp .env.example .env
#
# Keys are never written to logs, reports, caches or provenance records: see
# src/txbench/credentials.py. Offline imports, dry runs and fixture tests work
# with neither key set.

# Primary provider (Alchemy, Free plan is enough for the base collection).
ALCHEMY_API_KEY=

# Optional fallback (dRPC). Leave blank to run with Alchemy alone.
DRPC_API_KEY=
